# LangSmith 追踪配置模板
# 复制为 apps/server/.env（已 gitignore，严禁提交）并填入真实 key。
# 优先级：shell 环境变量 > 本文件。将来开放设置页配置后可改在界面填写。

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxx
# LangSmith 项目名默认取 AGENT_ID
LANGSMITH_AGENT_ID=personal-agent
LANGSMITH_AGENT_ENVIRONMENT=local
