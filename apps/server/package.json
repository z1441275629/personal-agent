{
  "name": "@pa/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server.cjs && node scripts/fix-import-meta.cjs dist/server.cjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.1",
    "@langchain/core": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pa/agents": "workspace:*",
    "@pa/guardrails": "workspace:*",
    "@pa/infra": "workspace:*",
    "@pa/llm": "workspace:*",
    "@pa/memory": "workspace:*",
    "@pa/persistence": "workspace:*",
    "@pa/retrieval": "workspace:*",
    "@pa/shared": "workspace:*",
    "@pa/tools": "workspace:*",
    "@pa/workflows": "workspace:*",
    "koa": "^3.3.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
