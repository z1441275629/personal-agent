{
  "name": "personal-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "桌面个人助理：每日培训、学习检查、定时提醒、后台调研（Electron + Vue3 + Koa + LangChain.js + Chroma）",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @pa/server --filter @pa/web dev",
    "dev:server": "pnpm --filter @pa/server dev",
    "dev:web": "pnpm --filter @pa/web dev",
    "dev:desktop": "pnpm --filter @pa/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test --if-present",
    "format": "prettier --write .",
    "chroma": "docker compose -f docker/docker-compose.yml up -d chroma",
    "chroma:local": "chroma run --path data/chroma --port 8000"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
